{:paths ["src/clj" "src/cljc" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        datalevin/datalevin {:mvn/version "1.2.10"}
        clj-kondo/clj-kondo {:mvn/version "2026.10.26"}
        rewrite-clj/rewrite-clj {:mvn/version "1.3.59"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        com.nextjournal/beholder {:mvn/version "1.0.3"}
        http-kit/http-kit {:mvn/version "2.9.0-beta4"}
        metosin/reitit-ring {:mvn/version "0.11.0"}
        ring/ring-core {:mvn/version "1.15.6"}
        com.cognitect/transit-clj {:mvn/version "1.1.367"}
        borkdude/edamame {:mvn/version "1.6.44"}
        nrepl/nrepl {:mvn/version "1.8.0"}
        org.clojure/tools.cli {:mvn/version "1.4.256"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}}
 :aliases
 {:jvm {:jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED"
                   "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
                   "--enable-native-access=ALL-UNNAMED"
                   "--sun-misc-unsafe-memory-access=allow"]}
  :dev {:extra-paths ["dev" "test/clj"]
        :extra-deps {cider/cider-nrepl {:mvn/version "0.64.0"}}}
  :cljs {:extra-paths ["src/cljs"]
         :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.10"}
                      re-frame/re-frame {:mvn/version "1.4.7"}
                      reagent/reagent {:mvn/version "2.0.1"}
                      com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}
  :test {:extra-paths ["test/clj"]
         :jvm-opts ["--add-opens=java.base/java.nio=ALL-UNNAMED" "--add-opens=java.base/sun.nio.ch=ALL-UNNAMED" "--enable-native-access=ALL-UNNAMED" "--sun-misc-unsafe-memory-access=allow"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}
  :run {:main-opts ["-m" "clj-browse.main"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}}}
